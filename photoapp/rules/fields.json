{
  "ocr_lang": "rus+eng",
  "fields": [
    {
      "key": "phone",
      "label": "Номер телефона",
      "normalize": "phone",
      "patterns": [
        "\\b(?:номер\\s*телефона|телефон[а-я]*|phone\\s*number|phone|тел)\\b\\.?\\s*[:\\-–]?\\s*((?:\\+7|8|7)?[\\s\\-()]*\\d{3}[\\s\\-()]*\\d{3}[\\s\\-]*\\d{2}[\\s\\-]*\\d{2})",
        "(\\+\\s?7[\\s\\-()]*\\d{3}[\\s\\-()]*\\d{3}[\\s\\-]*\\d{2}[\\s\\-]*\\d{2})"
      ]
    },
    {
      "key": "id",
      "label": "ID",
      "upper": true,
      "patterns": [
        "\\b(?:ваш|your)\\s*(?:id|ид|айди)\\b[^\\d]{0,20}?(\\d[\\d\\-]{4,})"
      ]
    },
    {
      "key": "bag_number",
      "label": "Номер сумки",
      "upper": true,
      "patterns": [
        "(?<![A-Za-zА-Яа-я0-9])([A-Za-zА-Яа-я]{2}\\s{0,3}\\d{4})(?![A-Za-zА-Яа-я0-9])"
      ],
      "latin": true,
      "skip_if": "геолокаци|geolocation|art\\.taxi|курьерские сервисы|данные из еси|ваш\\s*id|your\\s*id|номер\\s*телефона",
      "compact": true,
      "pick": "most_common",
      "inv_if": "инвентарь|термосумк|термобокс",
      "inv_patterns": [
        "термобокс\\s*([A-Za-z]{2}\\d{3}[A-Za-z])",
        "термосумка\\s*([A-Za-z]{2}\\d{4})"
      ]
    },
    {
      "key": "service",
      "label": "Сервис",
      "pick": "most_common",
      "options": {
        "Лавка": [
          "л\\s*а\\s*в\\s*к",
          "lavka",
          "\\blavk"
        ],
        "Еда": [
          "(?<![а-яё])еда(?![а-яё])",
          "\\beda\\b",
          "\\bfood\\b",
          "яндекс\\s*е\\s*д"
        ],
        "Доставка": [
          "яндекс\\s*доставк",
          "\\bdelivery\\b"
        ]
      },
      "skip_if": "курьерские сервисы|art\\.taxi|данные из еси|ваш\\s*id|your\\s*id"
    }
  ]
}
